# macOS
.DS_Store

# Claude Code のローカル設定（各自の環境依存なので共有しない）
.claude/

# 重い元データ（サイトでは未使用・ローカル保管）。使用中の shippou_tile.jpg のみ追跡する
assets/patterns/*.jpg
!assets/patterns/shippou_tile.jpg
assets/logo/yoriyoi_fab.svg
assets/logo/yoriyoi_fab-*.png

# 公開しない編集用デザイン元データ
# 公開用に書き出した SVG / PNG / JPG のみ Git で管理する
*.ai
*.psd
*.indd
assets/logo/_check.html
assets/logo/*_backup.svg

# Discord等の内部進捗ログ（ローカル専用）
logs/
